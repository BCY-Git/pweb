{
  "name": "martin-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Martin 的个人作品集全栈 MonoRepo",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm prisma:generate && pnpm lint:check && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --parallel --filter @martin-portfolio/web --filter @martin-portfolio/api --filter personal-workbench dev",
    "dev:api": "pnpm --filter @martin-portfolio/api dev",
    "dev:web": "pnpm --filter @martin-portfolio/web dev",
    "format": "pnpm -r --if-present format",
    "lint": "pnpm -r --if-present lint",
    "lint:check": "pnpm -r --if-present lint:check",
    "prisma:generate": "pnpm --filter @martin-portfolio/api prisma:generate",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
