# ─── 应用配置 ───
# 运行端口
PORT=3000
# 运行环境：development | production
NODE_ENV=development

# ─── 数据库 ───
# SQLite 文件路径（开发用；生产建议切到 PostgreSQL）
DATABASE_URL="file:./dev.db"

# ─── CORS ───
# 允许的前端来源，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── 鉴权（后台管理用，可选）────────────────────────
# JWT 密钥（生产请用 openssl rand -hex 32 生成；开发可留默认）
JWT_SECRET=dev-only-change-me-please-use-a-long-random-string
# JWT 过期时间
JWT_EXPIRES_IN=7d
# 初始管理员密码（首次 seed 时使用）
INIT_ADMIN_PASSWORD=

# ─── 静态托管（生产环境用）────────────────────────
# 前端构建产物目录（相对后端 cwd）。开发环境留空。
# 生产部署时设为 public，把前端 dist 内容拷到 backend/public
STATIC_DIR=

# ─── CSDN 集成 ───
# CSDN 用户名（公开主页 https://blog.csdn.net/<用户名>）
CSDN_USERNAME=m0_64547013
